# The MSan RUNTIME suppression file, exposed so xff/cc.bzl's cc_binary / cc_test wrappers can put it
# in each executable's `data` (runfiles) under --config=msan. MSan reads it at process start, so a
# runfile is exactly the right shape: declared, cache-correct, and inside the sandbox. Public because
# every package's binaries and tests reference it through those macros.
filegroup(
    name = "msan_suppressions",
    srcs = ["msan_suppressions.txt"],
    visibility = ["//visibility:public"],
)

# The smallest cc target there is: compile_commands-update.sh builds it under --config=clang to
# materialize the hermetic LLVM toolchain on a fresh checkout (so the extractor can point the DB
# at it). `manual` keeps it out of `//...`. Also prints the compiler, as a diagnostic.
cc_binary(
    name = "show_compiler",
    srcs = ["show_compiler.cc"],
    tags = ["manual"],
)

_SYMBOLIZER = "@llvm_toolchain_llvm//:llvm-symbolizer"

# Bake the hermetic llvm-symbolizer's RUNFILES path (an rlocation string) into the
# run-under wrapper under --config=clang; otherwise "auto" (system autodetection).
# A runfiles path stays valid when the LLVM toolchain is re-fetched to a new
# location each run, unlike a `readlink -f` absolute repository-cache path.
genrule(
    name = "generate_run_under_script",
    srcs = [":run_under_symbolizer.sh.in"],
    outs = ["run_under_symbolizer.sh"],
    cmd = select({
        "//:is_clang": "sed 's,%%SYMBOLIZER_RLOCATION%%,$(rlocationpath " + _SYMBOLIZER + "),' $< > $@",
        "//conditions:default": "sed 's,%%SYMBOLIZER_RLOCATION%%,auto,' $< > $@",
    }),
    executable = True,
    tags = ["manual"],
    tools = select({
        "//:is_clang": [_SYMBOLIZER],
        "//conditions:default": [],
    }),
)

sh_binary(
    name = "run_under_symbolizer",
    srcs = ["run_under_symbolizer.sh"],
    data = select({
        "//:is_clang": [_SYMBOLIZER],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

