# The virtual-filesystem seam: the read-only FileSystem interface plus the Entry / Metadata types
# every backend produces. It lives here rather than in the core for the same reason the others do -
# an extra that implements a filesystem (archive diving, #83; remote later) must not depend back
# into the core. Its only implementation is the correctness fallback for backends without efficient
# random access. //xff/vfs re-exports it, so core code keeps including "xff/vfs/entry.h" and
# "xff/vfs/filesystem.h" unchanged.
# Fixed-signature host boundary is separately linked so failure tests can supply
# their implementation without intercepting variadic C functions.
cc_library(
    name = "host_descriptors_interface_cc",
    hdrs = ["host_descriptors.h"],
    include_prefix = "xff/vfs",
)

cc_library(
    name = "vfs_cc",
    srcs = ["host_descriptors.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":host_descriptors_interface_cc",
        ":vfs_implementation_cc",
    ],
    # GNU ld sees this adapter before its consumers in vfs_implementation_cc.
    # Retain the three definitions regardless of static archive scanning order.
    alwayslink = True,
)

cc_library(
    name = "vfs_implementation_cc",
    srcs = [
        "directory_policy.cc",
        "filesystem.cc",
        "mutations.cc",
    ],
    hdrs = [
        "entry.h",
        "filesystem.h",
        "mutations.h",
    ],
    include_prefix = "xff/vfs",
    deps = [
        ":host_descriptors_interface_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@mboworks_mbo//mbo/status:status_macros_cc",
    ],
)

# The seam's contract, exercised by implementing it: the fake backend in this test is written using
# NOTHING but this module, which is the property that lets an extra provide a filesystem without
# depending on the xff core. It also pins the behaviours the engine relies on - per-path failures are
# statuses (so a walk continues), a read-only backend REFUSES removal instead of silently ignoring
# it, and an unset Entry/Metadata field means "ordinary real-filesystem entry" (read_only false).
cc_test(
    name = "vfs_test",
    size = "small",
    srcs = ["vfs_test.cc"],
    deps = [
        ":vfs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# The license-notice seam's contract: notices sort by component regardless of the static-init order
# they were registered in (otherwise the generated NOTICE.md file would reorder itself between builds and
# the committed copy would drift), a Registrar contributes the whole notice (name + SPDX id + text,
# since a NOTICE.md must reproduce all of it), and Notices() hands back a copy so a caller assembling
# text cannot corrupt the registry.
cc_test(
    name = "notice_test",
    size = "small",
    srcs = ["notice_test.cc"],
    deps = [
        ":license_notice_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The RegexBackend seam's contract, exercised by implementing it with a trivial literal backend -
# again using nothing but this module, which is the property the extras split exists to guarantee.
# Also pins the registration slot: UNREGISTERED reports Unimplemented ("not built into this binary",
# never confused with a bad pattern and never a silent RE2 fallback), and after a factory registers,
# the grammar reports available, receives case_insensitive, and a rejected pattern stays
# InvalidArgument.
cc_test(
    name = "backend_test",
    size = "small",
    srcs = ["backend_test.cc"],
    deps = [
        ":regex_backend_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "mutations_test",
    size = "small",
    srcs = ["mutations_test.cc"],
    deps = [
        ":vfs_cc",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "mutations_fault_test",
    size = "small",
    srcs = ["mutations_fault_test.cc"],
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--wrap=fstat",
            "-Wl,--wrap=fstatat",
            "-Wl,--wrap=mkdirat",
            "-Wl,--wrap=renameat",
            "-Wl,--wrap=fdopendir",
            "-Wl,--wrap=readdir",
