+#ifdef CRC_CLMUL
+// Process at most 15 bytes at either edge without reading outside the caller's
+// buffer. Keep the vectorized implementation for the aligned interior, and keep
+// sanitizer instrumentation enabled for every path.
+static uint64_t
+crc64_edge(const uint8_t *buf, size_t size, uint64_t crc)
+{
+	crc = ~crc;
+	while (size-- != 0) {
+		crc ^= *buf++;
+		for (unsigned i = 0; i < 8; ++i)
+			crc = (crc >> 1) ^ ((UINT64_C(0) - (crc & 1))
+					& UINT64_C(0xC96C5795D7870F42));
+	}
+	return ~crc;
+}
+
+static uint64_t
+crc64_clmul(const uint8_t *buf, size_t size, uint64_t crc)
+{
+	if (size == 0)
+		return crc;
+
+	size_t prefix = (0U - (uintptr_t)buf) & 15;
+	if (prefix > size)
+		prefix = size;
+	crc = crc64_edge(buf, prefix, crc);
+	buf += prefix;
+	size -= prefix;
+
+	const size_t aligned_size = size & ~(size_t)15;
+	if (aligned_size != 0) {
+		crc = crc64_clmul_aligned(buf, aligned_size, crc);
+		buf += aligned_size;
+		size -= aligned_size;
+	}
+	return crc64_edge(buf, size, crc);
+}
+#endif
