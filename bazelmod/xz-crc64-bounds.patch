+// Called only with a 16-byte-aligned buffer and a nonzero multiple of 16 bytes.
+static uint64_t
+crc64_clmul_aligned(const uint8_t *buf, size_t size, uint64_t crc)
 {
 	// The prototypes of the intrinsics use signed types while most of
