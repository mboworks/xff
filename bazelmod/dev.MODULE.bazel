"""Extra development modules (mirrors mboworks/mbo @ 1d17cc9)."""

# Kept under its CANONICAL module name, no repo_name alias: the extractor's own
# `refresh_compile_commands` macro hard-codes `@hedron_compile_commands//:print_args` as a plain
# string, which bazel resolves in the CALLING repo's mapping - so under an alias, a
# `refresh_compile_commands` target in this repo fails to load ("no repository visible as
# '@hedron_compile_commands'"). //:refresh_compile_commands needs that macro, hence the canonical
# name here. (Diverges from mboworks/mbo's copy for exactly this reason.)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    # The helly25 fork; compile_commands-update.sh relies on its `--bcce-*` runtime flags.
    commit = "85d83bc1ee3ab8034d9c40f6900a0753688068b6",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

bazel_dep(name = "depend_on_what_you_use", version = "1.2.0", dev_dependency = True)
