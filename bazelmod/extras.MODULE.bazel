"""The removable xff build-extra modules."""

# These declarations cannot be replaced by extras self-registering through a module extension. An
# extension sees a module's tags only after that module is already reachable from the root graph:
# without the bazel_dep an extra is invisible, while keeping the dependency and deleting its local
# path fails during repository mapping before the extension runs. A minimal source archive therefore
# removes the include of this file together with extra_modules/; CI executes exactly that operation.
#
# A local_path_override path inside the main repository would otherwise also be globbed as a package
# in the main repository (//extra_modules/pcre2:...), whose view cannot see the module's own @pcre2
# dependency. MODULE.bazel and REPO.bazel markers do not stop that dual view, so `extra_modules` is in
# //.bazelignore and each directory is owned only through its @xff_* module name. Keep new removable
# extras under extra_modules/ so the derivation tools and minimal-source operation remain mechanical.

bazel_dep(name = "xff_pcre2", version = "0.0.0")
local_path_override(
    module_name = "xff_pcre2",
    path = "extra_modules/pcre2",
)

bazel_dep(name = "xff_archive", version = "0.0.0")
local_path_override(
    module_name = "xff_archive",
    path = "extra_modules/archive",
)

bazel_dep(name = "xff_asar", version = "0.0.0")
local_path_override(
    module_name = "xff_asar",
    path = "extra_modules/asar",
)

bazel_dep(name = "xff_brotli", version = "0.0.0")
local_path_override(
    module_name = "xff_brotli",
    path = "extra_modules/brotli",
)

bazel_dep(name = "xff_squashfs", version = "0.0.0")
local_path_override(
    module_name = "xff_squashfs",
    path = "extra_modules/squashfs",
)

bazel_dep(name = "xff_fuse", version = "0.0.0")
local_path_override(
    module_name = "xff_fuse",
    path = "extra_modules/fuse",
)

bazel_dep(name = "xff_mime_db", version = "0.0.0")
local_path_override(
    module_name = "xff_mime_db",
    path = "extra_modules/mime_db",
)

bazel_dep(name = "xff_language_db", version = "0.0.0")
local_path_override(
    module_name = "xff_language_db",
    path = "extra_modules/language_db",
)

bazel_dep(name = "libexpat", version = "2.8.4")

# XAR is always available in the archive extra. Select only Mbed TLS's Apache-2.0 arm;
# XML parsing uses current Expat with entities disabled. These overrides disappear with extras.
single_version_override(
    module_name = "libarchive",
    patch_strip = 1,
    patches = ["//bazelmod:libarchive-xar.patch"],
)

archive_override(
    module_name = "libexpat",
    integrity = "sha256-qKnFy7qREAALE8yZQ/UPzX5VKly61JyxkRQsUAoKEbc=",
    patch_strip = 1,
    patches = ["//bazelmod:expat-build.patch"],
    strip_prefix = "libexpat-R_2_8_4",
    urls = ["https://github.com/libexpat/libexpat/archive/refs/tags/R_2_8_4.tar.gz"],
)

bazel_dep(name = "xff_apple", version = "0.0.0")
local_path_override(
    module_name = "xff_apple",
    path = "extra_modules/apple",
)
