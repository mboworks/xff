@@ -49,6 +50,42 @@
 ABSL_NAMESPACE_BEGIN
 namespace time_internal {
 namespace cctz {
+
+#if defined(__APPLE__)
+namespace {
+// Keep the framework open for the process lifetime: CoreFoundation owns global state.
+// Calling the same APIs lazily preserves macOS timezone discovery while avoiding
+// framework initialization for programs that never request the local timezone.
+struct CoreFoundationTimeZone {
+  void* handle = dlopen(
+      "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation",
+      RTLD_LAZY | RTLD_LOCAL);
+  decltype(&CFTimeZoneCopyDefault) copy_default =
+      Resolve<decltype(copy_default)>("CFTimeZoneCopyDefault");
+  decltype(&CFTimeZoneGetName) get_name =
+      Resolve<decltype(get_name)>("CFTimeZoneGetName");
+  decltype(&CFStringGetLength) get_length =
+      Resolve<decltype(get_length)>("CFStringGetLength");
+  decltype(&CFStringGetMaximumSizeForEncoding) get_maximum_size =
+      Resolve<decltype(get_maximum_size)>("CFStringGetMaximumSizeForEncoding");
+  decltype(&CFStringGetCString) get_c_string =
+      Resolve<decltype(get_c_string)>("CFStringGetCString");
+  decltype(&CFRelease) release = Resolve<decltype(release)>("CFRelease");
+
+  template <typename Function>
+  Function Resolve(const char* name) const {
+    return handle == nullptr ? nullptr
+                             : reinterpret_cast<Function>(dlsym(handle, name));
+  }
+
+  bool available() const {
+    return copy_default != nullptr && get_name != nullptr && get_length != nullptr
+           && get_maximum_size != nullptr && get_c_string != nullptr
+           && release != nullptr;
+  }
+};
+}  // namespace
+#endif

 std::string time_zone::name() const { return effective_impl().Name(); }

