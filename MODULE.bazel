"""Module mboworks_xff -- eXtended File Find."""

module(
    name = "mboworks_xff",
    version = "0.0.0",
)

# The removable extras are explicit local modules: `//...` cannot match another module, so their
# include is also the single source from which CI and compile-command tooling derive the complete
# list. A minimal source archive removes this one include together with extra_modules/.
include("//bazelmod:extras.MODULE.bazel")

extras_extension = use_extension("//tools:extras_repo.bzl", "extras_extension")
use_repo(extras_extension, "xff_extras")

# Local-development modules: hermetic LLVM toolchain + clangd compile-commands.
# (Mirrors mboworks/mbo; dev-only, not propagated to dependents.)
include("//bazelmod:dev.MODULE.bazel")
include("//bazelmod:llvm.MODULE.bazel")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_fuzzing", version = "0.8.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "utf8proc", version = "2.11.0")
# The published BUILD still uses native C++ rules removed in Bazel 9.
single_version_override(
    module_name = "utf8proc",
    patches = ["//bazelmod:utf8proc-bazel9.patch"],
    patch_strip = 1,
)
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = "com_github_google_benchmark")

# xff_extras_api lives at the top level (NOT under extra_modules/, which holds only removable
# extras), so a minimal core archive can drop extra_modules/ wholesale.
bazel_dep(name = "xff_extras_api", version = "0.0.0")
local_path_override(
    module_name = "xff_extras_api",
    path = "xff_extras_api",
)

bazel_dep(name = "mboworks_mbo", version = "0.15.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "mboworks_bashtest", version = "0.6.1")
