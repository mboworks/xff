# Directory traversal over a vfs::FileSystem: a worker pool reads (readdir+lstat)
# in parallel while a single coordinator thread visits in --sort order.
cc_library(
    name = "walk_cc",
    srcs = ["walk.cc"],
    hdrs = ["walk.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/types:span",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@mboworks_mbo//mbo/types:optional_ref_cc",
    ],
)

# Gives an archive member a real path for the length of one run (--archive-extract), so a child
# process can open what is otherwise only bytes inside a container.
# --archive-mount: a member's real path served by MOUNTING its container instead of copying the
# member out (the extract_cc alternative). The fuse seam is in @xff_extras_api, so the core needs no
# dependency on the extra itself; a lean binary gets the "not built in" answer.
cc_library(
    name = "mount_cc",
    srcs = ["mount.cc"],
    hdrs = ["mount.h"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@xff_extras_api//:fuse_backend_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

