load("//xff:cc.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Regular-expression matching for find's -regex/-iregex, backed by RE2 (+ EXACT/FNMATCH/GLOB core
# engines, and PCRE2 when the build extra is linked). The RegexBackend interface + PCRE2 registration
# API (`xff/matching/regex/backend.h`) now live in the standalone @xff_extras_api module - the seam an extra
# backend implements without depending back into the core - and are re-exported through regex.h.
cc_library(
    name = "regex_cc",
    srcs = ["regex.cc"],
    hdrs = ["regex.h"],
    visibility = [
        "//extra_modules:__subpackages__",
        "//xff:__subpackages__",
    ],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@mboworks_mbo//mbo/file:glob_cc",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@re2",
        "@xff_extras_api//:regex_backend_cc",
    ],
)

cc_test(
    name = "regex_test",
    size = "small",
    srcs = ["regex_test.cc"],
    deps = [
        ":regex_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# Explicit performance experiment, never a timing gate in the unit-test suite.
cc_binary(
    name = "regex_benchmark",
    srcs = ["regex_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":regex_cc",
        "@abseil-cpp//absl/strings:str_format",
        "@xff_pcre2//:pcre2_backend_cc",
    ],
)
