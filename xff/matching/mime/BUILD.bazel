load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Extension -> media (MIME) type via a curated static table (no libmagic dep), for
# the -mime GLOB content-type predicate.
cc_library(
    name = "mime_cc",
    srcs = ["mime.cc"],
    hdrs = ["mime.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/vfs:local_fs_cc",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@mboworks_mbo//mbo/types:optional_ref_cc",
        "@nlohmann_json//:json",
        "@xff_extras_api//:mime_database_cc",
    ],
)

cc_test(
    name = "mime_test",
    size = "small",
    srcs = ["mime_test.cc"],
    deps = [
        ":mime_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "mime_db_integration_test",
    size = "small",
    srcs = ["mime_db_integration_test.cc"],
    deps = [
        ":mime_cc",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_mime_db//:mime_db_register_cc",
    ],
)

cc_test(
    name = "default_cache_test",
    size = "small",
    srcs = ["default_cache_test.cc"],
    deps = [
        ":mime_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:mime_database_cc",
    ],
)
