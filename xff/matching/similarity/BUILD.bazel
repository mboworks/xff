load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//xff:cc.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "similarity_cc",
    srcs = ["similarity.cc"],
    hdrs = ["similarity.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "similarity_test",
    size = "small",
    srcs = ["similarity_test.cc"],
    deps = [
        ":similarity_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Exercise the exact verifier used by -similar over arbitrary byte strings and shingle widths. The
# symmetric and identity properties are useful oracles beyond crash detection.
cc_fuzz_test(
    name = "similarity_fuzz_test",
    size = "small",
    srcs = ["similarity_fuzz_test.cc"],
    corpus = glob(["similarity_fuzz_test_corpus/**"]),
    deps = [":similarity_cc"],
)

# Measures the exact verifier used by `-similar`, across input size, shingle width, and match shape.
# Manual because benchmark timings are evidence, not a pass/fail CI gate.
cc_binary(
    name = "similarity_benchmark",
    testonly = True,
    srcs = ["similarity_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":similarity_cc",
        "@abseil-cpp//absl/strings",
        "@com_github_google_benchmark//:benchmark",
    ],
)

# Design spike for near-duplicate grouping: compare exhaustive exact verification with an inverted
# shingle index that only generates candidates, then applies the same exact verifier before emitting.
cc_binary(
    name = "near_duplicate_benchmark",
    testonly = True,
    srcs = ["near_duplicate_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":similarity_cc",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/strings",
        "@com_github_google_benchmark//:benchmark",
    ],
)
