load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Filename / extension -> programming language via a curated static table (no github-linguist
# dependency), for the -lang GLOB predicate and the {lang} field.
cc_library(
    name = "language_cc",
    srcs = [
        "catalog.cc",
        "language.cc",
        "type_filter.cc",
    ],
    hdrs = [
        "catalog.h",
        "language.h",
        "type_filter.h",
    ],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/matching/regex:regex_cc",
        "//xff/vfs:local_fs_cc",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/container:inlined_vector",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/types:span",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@mboworks_mbo//mbo/types:optional_ref_cc",
        "@nlohmann_json//:json",
        "@xff_extras_api//:language_database_cc",
    ],
)

cc_test(
    name = "language_test",
    size = "small",
    srcs = ["language_test.cc"],
    deps = [
        ":language_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "catalog_test",
    size = "small",
    srcs = ["catalog_test.cc"],
    deps = [
        ":language_cc",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "language_db_integration_test",
    size = "small",
    srcs = ["language_db_integration_test.cc"],
    deps = [
        ":language_cc",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_language_db//:language_db_register_cc",
    ],
)
