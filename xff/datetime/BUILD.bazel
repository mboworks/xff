load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Parses human time strings (epoch / ISO-8601 / relative "N units ago") into an
# absolute instant. Backs find's -newerXt; reusable for any time argument.
cc_library(
    name = "datetime_cc",
    srcs = ["datetime.cc"],
    hdrs = ["datetime.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@mboworks_mbo//mbo/container:limited_map_cc",
    ],
)

cc_test(
    name = "datetime_test",
    size = "small",
    srcs = ["datetime_test.cc"],
    deps = [
        ":datetime_cc",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Exercise the retained CCTZ formatter contract for the local empty-fragment patch.
cc_test(
    name = "cctz_format_test",
    size = "small",
    srcs = ["cctz_format_test.cc"],
    deps = [
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
    ],
)
