# Build-time "composable extras" flags. Heavy / special dependencies are OFF by default so the
# stock `//xff/cli:xff` is a lean core; the extended `//xff/cli:xff_full` binary is composed from
# the same source tree by turning extras on. `bazel build --config=xff_full //xff/cli:xff_full` builds
# the full binary with every extra; a single extra can still be dropped from an otherwise-full
# build on the command line (e.g. `--config=xff_full --//xff:xff_pcre=false //xff/cli:xff_full`).
#
# Each extra is a self-registering backend target (under `extra_modules/`) that only `xff_full` links,
# via a `select()` on the extra's `config_setting`. Presence is detected at runtime from the
# registry the backend registers into (e.g. `xff::regex::Pcre2Available()`), so there is no
# `#ifdef` in the core and the lean binary simply never links the target - deleting the
# `extra_modules/` directory makes a `--//xff:xff_<extra>` build fail to compile while the lean build
# still builds. The matching CLI surface (`--regextype=PCRE2`, `--archive`, ...) is ALWAYS present;
# using an extra in a build that did not link it is a hard immediate error, never a silent no-op.
# See TODO.md "Composable-extras" and docs/design-config.md.

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//xff:cc.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

# Internal release-mode switch for ELF linker optimizations. `.bazelrc` enables it only through
# `--config=release`; the Linux constraint below ensures those LLD options never reach Mach-O links.
bool_flag(
    name = "xff_release_elf_link_optimizations",
    build_setting_default = False,
)

config_setting(
    name = "xff_release_elf_link_optimizations_enabled",
    flag_values = {":xff_release_elf_link_optimizations": "True"},
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

selects.config_setting_group(
    name = "release_elf_link_optimizations",
    match_all = [
        ":linux",
        ":xff_release_elf_link_optimizations_enabled",
    ],
    visibility = ["//xff/cli:__pkg__"],
)

# --//xff:xff_all -- turn on EVERY composable extra at once, whatever the set happens to be. It exists
# so `--config=xff_docs` (the config the committed XFF.md is generated from, and which must document
# the full surface) is a single line that cannot fall behind: each extra is linked when its OWN flag is
# set OR this one is, so a new extra is covered the moment it has a `:xff_<flag>_on` group below.
bool_flag(
    name = "xff_all",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_all_enabled",
    flag_values = {":xff_all": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_archive -- link the archive-diving backend (libarchive, plus a hand-written reader for
# PHP's native phar format, which libarchive does not handle; #83). Default off.
# (Build flags carry the `xff_` package prefix, like the library flags in STYLE_CPP.md.)
bool_flag(
    name = "xff_archive",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_archive_enabled",
    flag_values = {":xff_archive": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_asar -- link the standalone Electron ASAR reader. It composes with other container
# readers through @xff_extras_api and therefore does not pull in libarchive merely to host it.
bool_flag(
    name = "xff_asar",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_asar_enabled",
    flag_values = {":xff_asar": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_brotli -- add RFC 9841 / raw Brotli compression to the archive backend. This is a
# separate removable extra because libarchive deliberately does not own Brotli; turning it on also
# turns on the archive backend it extends.
bool_flag(
    name = "xff_brotli",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_brotli_enabled",
    flag_values = {":xff_brotli": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_squashfs -- link the standalone SquashFS reader. Like ASAR, it composes through the
# shared container registry without pulling in libarchive merely to host the format.
bool_flag(
    name = "xff_squashfs",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_squashfs_enabled",
    flag_values = {":xff_squashfs": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_pcre -- link the PCRE2 regex backend (extra_modules/pcre2; #85). Default off, so only
# `xff_full` built with the extra on links it. Without it, `--regextype=PCRE2` is a usage error (never
# a silent RE2 fallback).
bool_flag(
    name = "xff_pcre",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_pcre_enabled",
    flag_values = {":xff_pcre": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_fuse -- link the FUSE mount extra (extra_modules/fuse; #183). Default off. The extra
# compiles against fetched fuse3 headers and dlopens the runtime library per machine, so linking it
# adds no system library dependency.
bool_flag(
    name = "xff_fuse",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_fuse_enabled",
    flag_values = {":xff_fuse": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_mime_db -- link the comprehensive MIT-licensed mime-db
# vocabulary. The core keeps a compact common-type fallback.
bool_flag(
    name = "xff_mime_db",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_mime_db_enabled",
    flag_values = {":xff_mime_db": "True"},
    visibility = ["//visibility:public"],
)

# --//xff:xff_language_db -- link the comprehensive MIT-licensed GitHub
# Linguist vocabulary. The core retains a compact common-language fallback.
bool_flag(
    name = "xff_language_db",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_language_db_enabled",
    flag_values = {":xff_language_db": "True"},
    visibility = ["//visibility:public"],
)

# "Is this extra linked": its own flag OR --//xff:xff_all. Every consumer selects on THESE, never on
# the bare `_enabled` setting, which is what makes `xff_all` reach a new extra with no further edits.
selects.config_setting_group(
    name = "xff_archive_on",
    match_any = [
        ":xff_archive_enabled",
        ":xff_brotli_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_asar_on",
    match_any = [
        ":xff_asar_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_brotli_on",
    match_any = [
        ":xff_brotli_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_squashfs_on",
    match_any = [
        ":xff_squashfs_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_fuse_on",
    match_any = [
        ":xff_fuse_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_pcre_on",
    match_any = [
        ":xff_pcre_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_mime_db_on",
    match_any = [
        ":xff_mime_db_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "xff_language_db_on",
    match_any = [
        ":xff_language_db_enabled",
        ":xff_all_enabled",
    ],
    visibility = ["//visibility:public"],
)

# --//xff:xff_msan -- set by --config=msan (see .bazelrc). It exists so the cc_* wrappers in
# xff/cc.bzl (and the two genrules that RUN the instrumented binary) can `select()` the MSan runtime
# suppression file in ONLY in an MSan build: it is meaningless without -fsanitize=memory, and
# declaring the input unconditionally would add it to every action in every configuration.
# It does NOT gate the instrumented libc++ - that is the toolchain's `--features=msan`.
bool_flag(
    name = "xff_msan",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xff_msan_enabled",
    flag_values = {":xff_msan": "True"},
    visibility = ["//visibility:public"],
)

# The single "is this the full / extras build" condition: any extra on, however it was turned on. Both
# XFF_FULL_ONLY (xff_full's compatibility gate, //xff:extras.bzl) and the //xff alias below key on it,
# so "full mode" is defined in exactly one place.
selects.config_setting_group(
    name = "full_build",
    match_any = [
        ":xff_archive_on",
        ":xff_asar_on",
        ":xff_brotli_on",
        ":xff_fuse_on",
        ":xff_language_db_on",
        ":xff_mime_db_on",
        ":xff_pcre_on",
        ":xff_squashfs_on",
    ],
    visibility = ["//visibility:public"],
)

# `//xff` == the right binary for the active build config: the extended //xff/cli:xff_full in a full
# build (:full_build), else the lean //xff/cli:xff. So `bazel run //xff -- ...` follows your config -
# default it to --config=xff_full and //xff transparently means the full tool - without spelling out
# the //xff/cli path. The two underlying binaries stay explicit and config-stable (//xff/cli:xff is
# always lean, //xff/cli:xff_full always full); only this convenience alias adapts. It keys on the same
# :full_build as XFF_FULL_ONLY (xff_full's compatibility gate), so the alias can never resolve to an
# incompatible target.
alias(
    name = "xff",
    actual = select({
        ":full_build": "//xff/cli:xff_full",
        "//conditions:default": "//xff/cli:xff",
    }),
    visibility = ["//visibility:public"],
)

# The delivery half of the suppression plumbing, which nothing tested: a `*_OPTIONS` variable naming a
# suppressions file must find that file at run time. Uses the cc.bzl wrapper deliberately - the wrapper
# is what puts the file in the runfiles, so a test declared any other way would prove nothing.
cc_test(
    name = "suppressions_delivery_test",
    size = "small",
    srcs = ["suppressions_delivery_test.cc"],
    deps = [
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
