load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Source-agnostic interface: Entry/Metadata + the FileSystem abstraction.
# The VFS seam now lives in the shared @xff_extras_api base module (so an extra can implement a
# filesystem without depending back into the core). This alias keeps every existing
# `//xff/vfs:vfs_cc` dep and every `#include "xff/vfs/entry.h"` working unchanged.
alias(
    name = "vfs_cc",
    actual = "@xff_extras_api//:vfs_cc",
    visibility = ["//xff:__subpackages__"],
)

# Local filesystem backend (POSIX opendir/readdir + lstat/stat).
cc_library(
    name = "local_fs_cc",
    srcs = ["local_fs.cc"],
    hdrs = ["local_fs.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":vfs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@mboworks_mbo//mbo/status:status_macros_cc",
    ],
)

cc_test(
    name = "local_fs_test",
    size = "small",
    srcs = ["local_fs_test.cc"],
    deps = [
        ":local_fs_cc",
        ":vfs_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)
