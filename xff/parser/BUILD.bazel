load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "parser_cc",
    srcs = ["parser.cc"],
    hdrs = [
        "ast.h",
        "diagnostics.h",
        "parser.h",
    ],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/fuzzy:fuzzy_cc",
        "//xff/matching/regex:regex_cc",
        "//xff/presentation/fields:fields_cc",
        "//xff/registry:registry_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:cord",
        "@mboworks_mbo//mbo/container:limited_set_cc",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@mboworks_mbo//mbo/types:optional_ref_cc",
    ],
)

cc_test(
    name = "parser_test",
    srcs = ["parser_test.cc"],
    deps = [
        ":parser_cc",
        "//xff/matching/regex:regex_cc",
        "//xff/registry:registry_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# Arbitrary newline-framed argv vectors exercise the complete command grammar. The committed corpus
# is replayed by ordinary `bazel test`; the dictionary accelerates continuous libFuzzer campaigns.
cc_fuzz_test(
    name = "parser_fuzz_test",
    size = "small",
    srcs = ["parser_fuzz_test.cc"],
    corpus = glob(["parser_fuzz_test_corpus/**"]),
    dicts = ["parser_fuzz_test.dict"],
    deps = [":parser_cc"],
)

# Measures command-grammar parsing across expression sizes.  This is manual evidence rather than
# a pass/fail performance gate, so changes can be compared on the same machine and toolchain.
cc_binary(
    name = "parser_benchmark",
    testonly = True,
    srcs = ["parser_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":parser_cc",
        "@com_github_google_benchmark//:benchmark",
    ],
)
