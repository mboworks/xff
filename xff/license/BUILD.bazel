load("//xff:cc.bzl", "cc_library", "cc_test")
load("//xff_extras_api:license_body.bzl", "license_body")

# Visible to //extra_modules too: a build extra (e.g. extra_modules/pcre2) self-registers its notice
# here via license::Registrar, the same way core deps do.
package(default_visibility = ["//visibility:private"])

# xff's own license (Apache-2.0) is compiled into the binary from the canonical repo LICENSE file so
# a single-file release reproduces it (--help=license). LICENSE stays canonical; this only embeds
# it. The `xff_license` delimiter cannot appear in the license text. (The third-party NOTICE is NOT
# generated here -- it is assembled in code from self-registered components; see license.cc.)
genrule(
    name = "license_text_gen",
    srcs = ["//:LICENSE"],
    outs = ["license_text_generated.cc"],
    cmd = """(
      echo '// Generated from //:LICENSE by //xff/license:license_text_gen. Do not edit.'
      echo '#include "xff/license/license.h"'
      echo 'namespace xff::license {'
      printf 'std::string_view LicenseText() { return R"xff_license('
      cat $(location //:LICENSE)
      printf ')xff_license"; }\\n'
      echo '}  // namespace xff::license'
    ) > $@""",
)

license_body(
    name = "bsd_3_clause_license_cc",
    src = "BSD-3-Clause.txt",
    spdx = "BSD-3-Clause",
)

license_body(
    name = "mit_license_cc",
    src = "MIT.txt",
    spdx = "MIT",
)

# Preserve the complete upstream document: both MIT notices and the Unicode data terms.
license_body(
    name = "utf8proc_license_cc",
    src = "utf8proc-LICENSE.txt",
    spdx = "LicenseRef-utf8proc",
)

cc_library(
    name = "license_cc",
    srcs = [
        "license.cc",
        "license_text_generated.cc",
    ],
    hdrs = ["license.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":bsd_3_clause_license_cc",
        ":mit_license_cc",
        ":utf8proc_license_cc",
        "@abseil-cpp//absl/strings",
        "@xff_extras_api//:license_notice_cc",
    ],
)

cc_test(
    name = "license_test",
    size = "small",
    srcs = ["license_test.cc"],
    data = [
        "//:LICENSE",
    ],
    deps = [
        ":license_cc",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
    ],
)

# Separate process because notice registration is intentionally process-global.
cc_test(
    name = "license_section_test",
    size = "small",
    srcs = ["license_section_test.cc"],
    deps = [
        ":license_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
    ],
)
