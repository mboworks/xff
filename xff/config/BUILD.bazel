load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# The .xffrc grammar parser (bazel-rc-style flag bundles with base:config:
# selectors). Parse-only; the config loader and policy gate build on it.
cc_library(
    name = "xffrc_cc",
    srcs = ["xffrc.cc"],
    hdrs = ["xffrc.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "xffrc_test",
    size = "small",
    srcs = ["xffrc_test.cc"],
    deps = [
        ":xffrc_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The system INI parser (/etc/xff.ini): unsectioned globals and plain named sections.
# Parse-only; CLI validation checks flags and disables invalid sections atomically.
cc_library(
    name = "ini_cc",
    srcs = ["ini.cc"],
    hdrs = ["ini.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "ini_test",
    size = "small",
    srcs = ["ini_test.cc"],
    deps = [
        ":ini_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The resolver core combines parsed system defaults, user xffrc, and explicit
# --xffrc tiers under the active selectors into a precedence-ordered,
# provenance-tagged flag list.
cc_library(
    name = "config_cc",
    srcs = ["config.cc"],
    hdrs = ["config.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":ini_cc",
        ":xffrc_cc",
        "//xff/registry:registry_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.cc"],
    deps = [
        ":config_cc",
        ":xffrc_cc",
        "//xff/registry:registry_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Discovery locates and reads /etc/xff.ini, the selected user config, and
# explicit --xffrc files through an injectable FileReader, parsing them into
# ConfigInputs for ResolveConfig. It performs no file I/O of its own.
cc_library(
    name = "loader_cc",
    srcs = ["loader.cc"],
    hdrs = ["loader.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":config_cc",
        ":ini_cc",
        ":xffrc_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "loader_test",
    size = "small",
    srcs = ["loader_test.cc"],
    deps = [
        ":config_cc",
        ":loader_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The config policy gate classifies an xffrc line by registry safety, applies
# authoritative global prohibitions and preset-overload/non-arming constraints, and records each
# dropped line for warnings and --explain.
cc_library(
    name = "policy_cc",
    srcs = ["policy.cc"],
    hdrs = ["policy.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":config_cc",
        ":ini_cc",
        ":xffrc_cc",
        "//xff/registry:registry_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "policy_test",
    size = "small",
    srcs = ["policy_test.cc"],
    deps = [
        ":config_cc",
        ":ini_cc",
        ":policy_cc",
        ":xffrc_cc",
        "//xff/registry:registry_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# Feed arbitrary text through both config grammars and the complete policy/resolution pipeline.
# Ordinary tests replay the corpus; the bounded CI campaign mutates it.
cc_fuzz_test(
    name = "config_policy_fuzz_test",
    size = "small",
    srcs = ["config_policy_fuzz_test.cc"],
    corpus = glob(["config_policy_fuzz_test_corpus/**"]),
    dicts = ["config_policy_fuzz_test.dict"],
    deps = [
        ":config_cc",
        ":ini_cc",
        ":policy_cc",
        ":xffrc_cc",
    ],
)
