load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Content line matching: split a file's bytes into grep-style lines and select the
# matching ones (1-based number + text). Backs the `-grep` action's line output.
cc_library(
    name = "line_match_cc",
    srcs = ["line_match.cc"],
    hdrs = ["line_match.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/vfs:local_fs_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status:statusor",
        "@mboworks_mbo//mbo/status:status_macros_cc",
    ],
)

cc_test(
    name = "line_match_test",
    size = "small",
    srcs = ["line_match_test.cc"],
    deps = [
        ":line_match_cc",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "line_scan_test",
    size = "small",
    srcs = ["line_scan_test.cc"],
    deps = [
        ":line_match_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_library(
    name = "word_cc",
    srcs = ["word.cc"],
    hdrs = ["word.h"],
    visibility = ["//xff:__subpackages__"],
    deps = ["@utf8proc"],
)

cc_test(
    name = "word_unicode_test",
    srcs = ["word_unicode_test.cc"],
    deps = [
        ":word_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "snapshot_cc",
    srcs = ["snapshot.cc"],
    hdrs = ["snapshot.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        ":line_match_cc",
        "//xff/hash:hash_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_test(
    name = "snapshot_test",
    size = "small",
    srcs = ["snapshot_test.cc"],
    deps = [
        ":snapshot_cc",
        "//xff/hash:hash_cc",
        "//xff/vfs:vfs_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)
