load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Shared number/text formatting for human-facing output: grouped integers and
# column padding (the --summary table today; -ls alignment and --human next).
cc_library(
    name = "format_cc",
    srcs = ["format.cc"],
    hdrs = ["format.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "//xff/values:values_cc",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "format_test",
    size = "small",
    srcs = ["format_test.cc"],
    deps = [
        ":format_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:matchers_cc",
    ],
)

cc_library(
    name = "text_width_cc",
    srcs = ["text_width.cc"],
    hdrs = ["text_width.h"],
    visibility = ["//xff/presentation/render:__pkg__"],
    deps = ["@utf8proc"],
)

cc_test(
    name = "text_width_test",
    size = "small",
    srcs = ["text_width_test.cc"],
    deps = [
        ":text_width_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "text_width_unicode_test",
    size = "small",
    srcs = ["text_width_unicode_test.cc"],
    deps = [
        ":text_width_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
