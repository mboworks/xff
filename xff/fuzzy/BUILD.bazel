load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//xff:cc.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# Approximate matching, fzf-style: a pattern matches when its characters appear in order, with
# anything in between. Backs the -fuzzy / -ifuzzy primaries.
cc_library(
    name = "fuzzy_cc",
    srcs = ["fuzzy.cc"],
    hdrs = ["fuzzy.h"],
    visibility = ["//xff:__subpackages__"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "fuzzy_test",
    size = "small",
    srcs = ["fuzzy_test.cc"],
    deps = [
        ":fuzzy_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Fuzz every public matching model from the same pattern/text input. Besides crash detection, the
# driver checks the shared score-range and subsequence truth contracts.
cc_fuzz_test(
    name = "fuzzy_fuzz_test",
    size = "small",
    srcs = ["fuzzy_fuzz_test.cc"],
    corpus = glob(["fuzzy_fuzz_test_corpus/**"]),
    dicts = ["fuzzy_fuzz_test.dict"],
    deps = [":fuzzy_cc"],
)
