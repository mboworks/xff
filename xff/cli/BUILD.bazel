# Asserts xff_full actually LINKS every extra --config=xff_full enables (via --help=extras) - the CI
# guard that a shipping extra is never silently dropped from the full binary. XFF_FULL_ONLY, so
# `//...` runs it only under --config=xff_full (every CI test job); its assertions are unconditional.
bashtest(
    name = "full_extras_test",
    size = "small",
    srcs = ["full_extras_test.sh"],
    data = [
        ":xff_full",
        "@xff_archive//:mini_tar",
        "@xff_squashfs//:mini_sqfs",
    ],
    # XFF_MSAN is the shell-side twin of the C++ `MEMORY_SANITIZER` macro: the mounting cases run
    # through the dlopened system libfuse3, which MSan did not instrument and therefore reports as
    # uninitialized. Keyed on the same flag `--config=msan` already sets.
    env = {
        "XFF_MINI_SQFS": "$(rootpath @xff_squashfs//:mini_sqfs)",
        "XFF_MINI_TAR": "$(rootpath @xff_archive//:mini_tar)",
    } | select({
        "//xff:xff_msan_enabled": {"XFF_MSAN": "1"},
        "//conditions:default": {},
    }) | select({
        "@xff_extras_api//:fuse_tests_required": {"XFF_FUSE_TESTS_REQUIRED": "1"},
        "//conditions:default": {},
    }),
    # --archive-mount actually mounts, which needs /dev/fuse and the setuid fusermount3 - neither
    # exists inside bazel's linux sandbox. Scoped to the TEST action (see @xff_fuse's server test for
    # why a target-wide no-sandbox tag is wrong: it unsandboxes the compile too).
    exec_properties = {"test.no-sandbox": "1"},
    tags = ["release-binary"],
    target_compatible_with = XFF_FULL_ONLY,
)

# Dual-binary parity: runs core (non-extras) commands through both the lean `xff` and the extended
# `xff_full` and asserts identical output - they share main_cc, so they must never diverge on
# non-extension behavior. XFF_FULL_ONLY (it needs xff_full), so `//...` runs it under
# --config=xff_full (every CI test job builds both binaries) and skips it in a lean build.
bashtest(
    name = "parity_test",
    size = "small",
    srcs = ["parity_test.sh"],
    data = [
        ":xff",
        ":xff_full",
    ],
    target_compatible_with = XFF_FULL_ONLY,
)

# The //xff alias is config-adaptive (lean //xff/cli:xff by default, //xff/cli:xff_full in a full
# build). This asserts the FULL direction: XFF_FULL_ONLY, so `//...` runs it under --config=xff_full,
# where //xff must resolve to the full binary (PCRE2 linked) while //xff/cli:xff stays lean. The
# binaries arrive via $(rootpath ...) args so the test exercises the alias's actual resolution, and
# it runs them directly (no bazel run -> clean output).
bashtest(
    name = "alias_test",
    size = "small",
    srcs = ["alias_test.sh"],
    args = [
