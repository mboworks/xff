package(default_visibility = ["//visibility:private"])

# LLD defaults to -O1. -O2 adds string-tail merging and branch-to-branch optimization;
# --icf=safe folds code only where address identity is not observable. Packed RELR is compatible
# with glibc 2.36+, below the GLIBC 2.38 ABI floor of the published Linux binaries.
RELEASE_ELF_LINKOPTS = select({
    "//xff:release_elf_link_optimizations": [
        "-Wl,-O2",
        "-Wl,--icf=safe",
        "-Wl,-z,pack-relative-relocs",
    ],
    "//conditions:default": [],
})

# main.cc (the CLI entry point, `main()` included) as a library, so the lean `xff` and the extended
# `xff_full` are both thin binaries over it: main.cc compiles once, neither binary carries its own
# main(), and `xff_full` differs only by the composable extras it additionally links (see
# xff/BUILD.bazel). Sharing one main() is why the two cannot drift.
cc_library(
    name = "main_cc",
    srcs = ["main.cc"],
    deps = [
        ":globals_cc",
        ":help_backend_cc",
        ":help_build_cc",
        ":help_cc",
        ":help_width_cc",
        ":html_cc",
        ":manpage_cc",
        ":markdown_cc",
        ":pager_cc",
        ":plain_backend_cc",
        ":wrap_cc",
        "//xff/config:config_cc",
        "//xff/config:loader_cc",
        "//xff/config:policy_cc",
        "//xff/engine:evaluate_cc",
        "//xff/engine:run_cc",
        "//xff/env:env_cc",
        "//xff/matching/regex:regex_cc",
        "//xff/parser:parser_cc",
        "//xff/presentation/color:color_cc",
        "//xff/presentation/format:format_cc",
        "//xff/registry:registry_cc",
        "//xff/vfs:local_fs_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/types:span",
        "@mboworks_mbo//mbo/types:optional_ref_cc",
    ],
)

# The stock lean binary: core only, no composable extras. This is the target every test and golden
# runs against, and the one built by `//...`.
cc_binary(
    name = "xff",
    linkopts = RELEASE_ELF_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = [":main_cc"],
)

# The extended binary: the same core plus every composable extra that is turned on. Incompatible in a
# lean build (XFF_FULL_ONLY), so `//...` skips it there and links it under `--config=xff_full`; the
# extras (and @pcre2) are never pulled otherwise. Its `xff_full` invocation name maps back to the base
# style (DefaultStyleForProgram strips the `_full` suffix), so it behaves exactly as `xff` with the
# extras present. The PCRE2 backend (@xff_pcre2) links in via the `select` on //xff:xff_pcre_enabled.
cc_binary(
    name = "xff_full",
    linkopts = RELEASE_ELF_LINKOPTS,
    target_compatible_with = XFF_FULL_ONLY,
    visibility = ["//visibility:public"],
    deps = [":main_cc"] + select({
        "//xff:xff_archive_on": ["@xff_archive//:archive_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_asar_on": ["@xff_asar//:asar_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_brotli_on": ["@xff_brotli//:brotli_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_fuse_on": ["@xff_fuse//:fuse_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_language_db_on": ["@xff_language_db//:language_db_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_mime_db_on": ["@xff_mime_db//:mime_db_register_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_pcre_on": ["@xff_pcre2//:pcre2_backend_cc"],
        "//conditions:default": [],
    }) + select({
        "//xff:xff_squashfs_on": ["@xff_squashfs//:squashfs_register_cc"],
        "//conditions:default": [],
    }),
)

