# Generate Markdown and HTML together through the same release helper and all-extras binary. The
# checked-in Markdown is diffed below; release CI publishes BOTH outputs from this exact action, so
# its browsable HTML cannot silently come from a different binary or generation path.
genrule(
    name = "xff_reference_gen",
    # Under --config=msan the suppression file has to be an input here too: this action RUNS the
    # instrumented binary, and a genrule's working directory is the execroot, which is the path
    # MSAN_OPTIONS=suppressions= names (see .bazelrc).
    srcs = select({
        "//xff:xff_msan_enabled": ["//tools:msan_suppressions"],
        "//conditions:default": [],
    }),
    outs = [
        "XFF.html.actual",
        "XFF.md.actual",
    ],
    cmd = "$(location //tools:generate_reference) $(location :xff_full) $(location XFF.md.actual) $(location XFF.html.actual)",
    target_compatible_with = XFF_FULL_ONLY,
    tools = [
        ":xff_full",
        "//tools:generate_reference",
    ],
)

diff_test(
    name = "xff_markdown_test",
    file_new = ":XFF.md.actual",
    file_old = "//:XFF.md",
    target_compatible_with = XFF_FULL_ONLY,
)

# The committed //:NOTICE is verbatim `xff_full --help=notice`. Unlike the runtime notice of a lean
# binary, the repository artifact deliberately inventories every supported extension. Generating it
# from the same all-extras binary as XFF.md prevents legal metadata from drifting independently of
# the self-registering component registry. To refresh: ./notice-update.sh.
genrule(
    name = "xff_notice_gen",
    srcs = select({
        "//xff:xff_msan_enabled": ["//tools:msan_suppressions"],
        "//conditions:default": [],
    }),
    outs = ["NOTICE.actual"],
    cmd = "XFF_CONFIG=/nonexistent $(location :xff_full) --help=notice > $@",
    target_compatible_with = XFF_FULL_ONLY,
    tools = [":xff_full"],
)

diff_test(
    name = "xff_notice_test",
    file_new = ":NOTICE.actual",
    file_old = "//:NOTICE",
    target_compatible_with = XFF_FULL_ONLY,
)

