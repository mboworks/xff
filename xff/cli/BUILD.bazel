# End-to-end test of the extended `xff_full` binary: its `_full` invocation name resolves to the xff
# style, and PCRE2 patterns work (an RE2-rejected backreference matches). Drives xff_full, so it is
# XFF_FULL_ONLY - `bazel test //...` skips it in a lean build and runs it under `--config=xff_full`.
bashtest(
    name = "full_binary_test",
    size = "small",
