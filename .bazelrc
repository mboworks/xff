# To debug bazel options, uncomment next line.
# common --announce_rc

# Allow platform specific control and add the missing 'CoreFoundation' lib.
common --enable_platform_specific_config

# Define the Apple OS (flags mirror mboworks/mbo).
common --apple_platform_type=macos
common:macos --features=-macos_default_link_flags
common:macos --features=-supports_dynamic_linker
common:macos --linkopt=-framework --linkopt=CoreFoundation --host_linkopt=-framework --host_linkopt=CoreFoundation
common:macos --linkopt=-Wl,-undefined,dynamic_lookup --host_linkopt=-Wl,-undefined,dynamic_lookup
# Apple Silicon: 11.0 is the earliest arm64 macOS and clears libc++'s
# std::filesystem availability gate. copt, not cxxopt: C deps (pcre2) need it too.
common:macos --copt=-mmacosx-version-min=11.0 --host_copt=-mmacosx-version-min=11.0
common:macos --linkopt=-mmacosx-version-min=11.0 --host_linkopt=-mmacosx-version-min=11.0

try-import %workspace%/.bazelrc.user

common --consistent_labels
common --enable_bzlmod --noenable_workspace
common --incompatible_disallow_empty_glob
common --nolegacy_external_runfiles
common --features=layering_check,parse_headers --host_features=layering_check,parse_headers

# Define absl=1 to tell googletest to use absl for backtrace.
common --define absl=1

# xff is a C++23 project.
common --cxxopt=-std=c++23 --host_cxxopt=-std=c++23

# Warnings policy: everything we control compiles with ALL warnings as errors (-Wextra and
# -Wpedantic on top of the toolchain's -Wall), while genuinely third-party code keeps its warnings
# non-fatal. "We control" includes the composable extras and the shared extras API: they are
# local_path_override modules, so their sources compile under the external/xff_*+ spelling - the
# blanket external/* downgrade used to EXEMPT them from -Werror entirely, which is the hole the
# exclusion filter closes.
#  - external_include_paths: external repo headers become -isystem, so a third-party header
#    included by our TU never trips our -Wpedantic.
#  - external sources are MUTED (-w), not merely un-escalated, EXCEPT our own external/xff_* modules.
#    `-Wno-error` was the wrong tool: it keeps the diagnostic and only stops it failing the build, so
#    every compile still printed it. With --features=parse_headers a third-party HEADER is compiled
#    as its own external TU, which is how a permanent line like
#      external/googletest+/googlemock/src/gmock.cc:47: '__COUNTER__' is a C2y extension
#    reached every build log. A warning in code we will never edit is noise, not signal.
#  - and all of it applies in the EXEC configuration too (--host_*), which had no policy at all:
#    first-party host warnings were not errors, and external host warnings were not muted.
common --features=external_include_paths --host_features=external_include_paths
common --copt=-Werror --cxxopt=-Werror
common --per_file_copt=external/.*,-external/xff_.*@-w
common --host_per_file_copt=external/.*,-external/xff_.*@-w
# Carve-outs, each with its reason (gcc quietly ignores the -Wno- spellings it lacks on a clean
# compile, so the union is safe on both compilers):
#  - nullability-extension: absl's CHECK/LOG macros expand the `_Nonnull` clang extension into OUR
#    translation units, which -Wpedantic would flag at every use.
#  - missing-(designated-)field-initializers: partial designated initializers ARE the codebase
#    idiom (the registry and globals tables name only the fields that matter; the standard
#    value-initializes the rest). gcc spells the -Wextra member one way, clang 22+ the other.
common --per_file_copt=.*,-external/.*@-Wextra,-Wpedantic,-Wno-nullability-extension,-Wno-missing-field-initializers,-Wno-missing-designated-field-initializers
common --per_file_copt=external/xff_.*@-Wextra,-Wpedantic,-Wno-nullability-extension,-Wno-missing-field-initializers,-Wno-missing-designated-field-initializers
# The same bar in the exec configuration: a build tool is our code too, and -Werror there was absent.
common --host_copt=-Werror --host_cxxopt=-Werror
common --host_per_file_copt=.*,-external/.*@-Wextra,-Wpedantic,-Wno-nullability-extension,-Wno-missing-field-initializers,-Wno-missing-designated-field-initializers
common --host_per_file_copt=external/xff_.*@-Wextra,-Wpedantic,-Wno-nullability-extension,-Wno-missing-field-initializers,-Wno-missing-designated-field-initializers

# libarchive's Bazel build selects futimesat on Linux but compiles its C sources in a language mode
# that hides glibc's GNU declarations under GCC 14. Expose the declaration in both target and
# exec configurations; coverage builds host tools that link libarchive, so fixing only the target
# configuration leaves the same error in a `[for tool]` compile.
common --per_file_copt=external/libarchive.*@-D_GNU_SOURCE
common --host_per_file_copt=external/libarchive.*@-D_GNU_SOURCE

test --test_output=errors

common --copt=-fdiagnostics-color=always
common --copt=-fno-exceptions

# --config=xff_full : build the extended "full" binary (`//xff/cli:xff_full`, a `manual` target) with
# EVERY composable extra linked in, via the single --//xff:xff_all flag - so the config keeps its
# promise as extras are added, with nothing to update here (it used to set only xff_pcre, a stale
# leftover from before #83 wired the archive backend). Drop one extra from an otherwise-full build by
# overriding on the command line, e.g. `bazel build --config=xff_full --//xff:xff_archive=false
# //xff/cli:xff_full`.
common:xff_full --//xff:xff_all=True

# --config=xff_docs : the FULL DOCUMENTED SURFACE, the stable name CI and the XFF.md drift guard
# build with. Since xff_full now turns every extra on itself, this is an alias kept for those
# callers; the two being identical is the point - the published reference documents exactly what a
# full build contains.
common:xff_docs --config=xff_full

# --config=xff_fuse_tests_required : promise that this test runner can mount through kernel FUSE.
# The tests then fail rather than silently skip if libfuse, /dev/fuse, permissions, or the mount
# helper stop working. This is deliberately explicit: the OS alone cannot prove mount capability.
common:xff_fuse_tests_required --@xff_extras_api//:fuse_tests_must_mount=true

# Register the hermetic LLVM/clang toolchain ONLY for `--config=clang`. Bazel 9
# always resolves C++ toolchains, so `--extra_toolchains` (higher priority than
# the autodetected local toolchain) keeps gcc/native builds on the local compiler.
common:clang --extra_toolchains=@llvm_toolchain_llvm//:all
common:clang --cxxopt=-gmlt --host_cxxopt=-gmlt
common:clang --linkopt=-fuse-ld=lld --host_linkopt=-fuse-ld=lld
common:clang --define is_clang=true

# --config=clang-coverage : collect C++ coverage with the same hermetic Clang/libc++ toolchain
# that owns the default build. Bazel otherwise defaults C++ coverage to the local gcov toolchain.
common:clang-coverage --config=clang
common:clang-coverage --experimental_use_llvm_covmap
common:clang-coverage --experimental_generate_llvm_lcov

# --config=clang-tidy : the configuration we DEVELOP in, and the one the compile
# Named config the compile DB is generated in (compile_commands-update.sh). Adds no
# flags: the toolchain handles libc++ itself (see git_override in bazelmod/llvm.MODULE.bazel).
common:clang-tidy --config=clang

# --config=fuzz : continuous in-process fuzzing with clang, libFuzzer, and ASan. Ordinary
# `bazel test` uses rules_fuzzing's replay engine instead, so every committed seed and minimized
# regression stays in the normal test suite without turning CI into an unbounded fuzzing run.
# Launch every bounded local campaign through the repository driver. It discovers targets directly
# from BUILD files and applies the Darwin libFuzzer/libc++ runtime compatibility environment without
# weakening ASan on Linux:
#   tools/fuzz_targets.py --campaign-seconds=60
common:fuzz --config=clang
common:fuzz --@rules_fuzzing//fuzzing:cc_engine=@rules_fuzzing//fuzzing/engines:libfuzzer
common:fuzz --@rules_fuzzing//fuzzing:cc_engine_instrumentation=libfuzzer
common:fuzz --@rules_fuzzing//fuzzing:cc_engine_sanitizer=asan

common:symbolizer --strip=never
common:symbolizer --run_under=//tools:run_under_symbolizer

# --config=asan : run with `--config=clang --config=asan` (macOS + clang-22 works
# via toolchains_llvm >= 1.8.0 / #769). The toolchain also drives sanitizers via the `asan`
# feature (#765); the explicit -fsanitize copts/linkopts keep it working elsewhere too.
# Enables AddressSanitizer + UndefinedBehaviorSanitizer (vptr excluded: it needs RTTI
# across TUs). -fno-sanitize-recover makes UB a hard failure, matching the
# UBSAN_OPTIONS=halt_on_error below (otherwise UBSan only logs a warning and passes).
common:asan --config=symbolizer
common:asan --copt=-g
common:asan --copt=-fsanitize=address,undefined
common:asan --copt=-fno-sanitize=vptr
common:asan --copt=-fno-sanitize-recover=undefined
common:asan --copt=-fno-omit-frame-pointer
common:asan --copt=-DADDRESS_SANITIZER
common:asan --linkopt=-fsanitize=address,undefined
common:asan --linkopt=-fno-sanitize=vptr
common:asan --linkopt=-ldl
common:asan --build_tag_filters=-no_san  # skip targets tagged no_san
common:asan --test_tag_filters=-no_san
common:asan --features=asan  # https://github.com/bazelbuild/bazel/issues/6932
common:asan --action_env=ASAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:color=always
common:asan --action_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:color=always
common:asan --test_env=ASAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:color=always
common:asan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:color=always

# --config=tsan : ThreadSanitizer, run with `--config=clang --config=tsan`. Mutually
# exclusive with asan (a separate matrix cell), so the parallel walk's data-race
# coverage lives here. Mirrors the asan block; the `tsan` feature drives the
# hermetic toolchain and the explicit -fsanitize copt/linkopt keeps it portable.
common:tsan --config=symbolizer
common:tsan --copt=-g
common:tsan --copt=-fsanitize=thread
common:tsan --copt=-fno-omit-frame-pointer
common:tsan --copt=-DTHREAD_SANITIZER
common:tsan --linkopt=-fsanitize=thread
common:tsan --build_tag_filters=-no_san  # skip targets tagged no_san
common:tsan --test_tag_filters=-no_san
common:tsan --features=tsan
common:tsan --action_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1:symbolize=1:color=always
common:tsan --test_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1:symbolize=1:color=always

# --config=msan : MemorySanitizer (reads of uninitialized memory - what asan does NOT
# catch), run with `--config=clang --config=msan`. LINUX ONLY (there is no macOS MSan),
# so this is a single Linux CI cell.
#
# MSan false-positives on anything it did not instrument, so EVERY library linked in must
# be instrumented. Our deps all build from source under bazel, so `-fsanitize=memory` reaches
# them for free; the exception is the C++ standard library, which ships PREBUILT (and
# uninstrumented) inside the hermetic LLVM distribution.
#
# That last piece is handled by the TOOLCHAIN, not by us: `--features=msan` is toolchains_llvm's
# own MemorySanitizer feature (Linux only, >= 1.8.0). It adds `-fsanitize=memory
# -fsanitize-memory-track-origins -fsanitize-link-c++-runtime` AND swaps the whole standard
# library over to the instrumented libc++ overlay that `libcxx_url` fetches into the
# distribution (see bazelmod/llvm.MODULE.bazel) - headers (`-cxx-isystem .../libcxx-msan/...`),
# archives (`-l:libc++.a -l:libc++abi.a`) and `-stdlib=libc++ -rtlib=compiler-rt` in one step,
# with the ORDINARY stdlib flags gated off. Gating the ordinary flags off is the part that makes
# it work: bolting the instrumented tree on as extra include paths (what we tried first) leaves
# two libc++ trees on the search path and breaks libc++'s `#include_next` C-header shims.
#
# A `--features` flag is also the right shape for a sanitizer: bazel resets it to
# `--host_features` in the exec configuration, so build tools stay uninstrumented.
common:msan --config=symbolizer
common:msan --features=msan
common:msan --copt=-g
common:msan --copt=-fno-omit-frame-pointer
common:msan --copt=-DMEMORY_SANITIZER
# Turns on the `data` select in xff/cc.bzl's cc_binary / cc_test wrappers, which put
# tools/msan_suppressions.txt into each executable's runfiles. MSan is a RUNTIME sanitizer:
# it reads the suppression file when the process starts, so a declared runfile is the right
# shape (inside the sandbox, cache-correct, no per-target boilerplate) - unlike a --copt
# naming a path bazel knows nothing about. MSAN_OPTIONS below points at the runfiles path.
common:msan --//xff:xff_msan=true
common:msan --build_tag_filters=-no_san  # skip targets tagged no_san
common:msan --test_tag_filters=-no_san
# Build ACTIONS that run the instrumented binary (the golden generators, xff_markdown_gen) need the
# suppressions too. A genrule's working directory is the execroot, so the same relative path works -
# provided the file is an input of the action, which those genrules declare under //xff:xff_msan.
common:msan --action_env=MSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:suppressions=tools/msan_suppressions.txt
# `suppressions=` is runfiles-relative on purpose: a test runs with its runfiles tree as the
# working directory, and the cc_test wrapper puts the file at that path, so no absolute or
# workspace path is needed. Documented known false positives live in the file itself.
common:msan --test_env=MSAN_OPTIONS=halt_on_error=1:print_stacktrace=1:symbolize=1:suppressions=tools/msan_suppressions.txt

try-import %workspace%/.bazelrc.user.end
