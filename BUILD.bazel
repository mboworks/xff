load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@xff_extras//:extras.bzl", "EXTRAS_TARGETS")
load("//bazelmod:clang_tidy_targets.bzl", "CLANG_TIDY_MANUAL_TARGETS")

package(default_visibility = ["//visibility:private"])

# The compile database clang-tidy and clangd read, generated by ./compile_commands-update.sh.
#
# It exists as an explicit target rather than the extractor's stock `refresh_all` because
# `refresh_all` covers `//...` only, and the composable extras are separate bazel MODULES
# (`extra_modules/*`, reached as `@xff_archive` / `@xff_pcre2`) that no `//...` pattern matches. The
# consequence was a silent blind spot: every extras translation unit was absent from the database, so
# clang-tidy could not even resolve the extra's own header (`'xff/archive/archive_reader.h' file not
# found`) and its findings there were meaningless. Each extra also needs its own build flag, which is
# what the per-target value in this dict is for - without the flag the extra's targets do not build.
#
# The extras are DERIVED from bazelmod/extras.MODULE.bazel (tools/extras_repo.bzl), not listed here: an extra missing
# from this target is invisible to clang-tidy and clangd, and that failure is silent - it looks clean.
# No per-extra build flag is needed, which is what makes the list derivable at all: `--//xff:xff_<extra>`
# gates whether the CORE links an extra, not whether the extra itself builds, and the extractor is
# pointed straight at the extra's own targets. (Verified: the database gets the same entries with and
# without those flags.)
refresh_compile_commands(
    name = "refresh_compile_commands",
    targets = ["//..."] + CLANG_TIDY_MANUAL_TARGETS + EXTRAS_TARGETS,
)

filegroup(
    name = "clang-format",
    srcs = [".clang-format"],
    visibility = ["//visibility:public"],
)

# LICENSE is compiled into the binary and NOTICE.md is generated from the all-extras binary, so a
# single-file release reproduces its own terms and the repository inventories the complete build.
exports_files(
    [
        "LICENSE",
        "NOTICE.md",
        "NOTICE.lean.md",
    ],
    visibility = ["//visibility:public"],
)

# XFF.md and NOTICE.md are generated, committed references. The //xff/cli drift tests regenerate them
# from the all-extras binary; xff-md-update.sh and notice-update.sh rewrite them.
exports_files(
    ["XFF.md"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_clang",
    define_values = {"is_clang": "true"},
)

# Repository files inspected by Python regression tests; no checkout escape is needed.
filegroup(
    name = "python_workflow_test_data",
    srcs = [
        ".github/actions/bazel-cache-restore/action.yml",
        ".github/actions/bazel-cache-save/action.yml",
        ".github/workflows/benchmark_pages.yml",
        ".github/workflows/benchmarks.yml",
        ".github/workflows/cache_size.yml",
        ".github/workflows/coverage_pages.yml",
        ".github/workflows/fuzz.yml",
        ".github/workflows/main.yml",
        ".github/workflows/pages.yml",
        ".github/workflows/release.yml",
    ],
    visibility = ["//tools:__pkg__"],
)

filegroup(
    name = "python_artwork_test_data",
    srcs = [
        "docs/assets/apple-touch-icon.png",
        "docs/assets/favicon.ico",
        "docs/assets/favicon.png",
    ],
    visibility = ["//tools:__pkg__"],
)

filegroup(
    name = "python_release_notes_test_data",
    srcs = [".github/release-notes.md.template"],
    visibility = ["//tools:__pkg__"],
)
