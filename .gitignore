__pycache__/

# Symlink added by bazel-compile-commands-extractor (no trailing slash: it's a symlink).
/external
# Bazel output symlinks.
/bazel-*
# Generated clangd compile DB.
/compile_commands.json
# clangd local index.
/.cache/
/.vscode/

/.bazelrc.user
/.bazelrc.user.end
/MODULE.bazel.lock
.DS_Store

# Committed BINARY test fixtures. A contributor's GLOBAL gitignore very commonly ignores archive
# extensions (`*.jar`, `*.zip`, `*.tar`, `*.gz`, ...), and a global ignore silently drops such a file
# from `git add` - it happened: four phar fixtures were missing from the repo while every local test
# still passed, because the files were present on disk. A repo-level negation outranks the global
# file, so these are always trackable.
!extra_modules/archive/test_data/**
!extra_modules/apple/test_data/**
