load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

# The runtime FUSE loader (epic #183, slice 1): dlopen the platform's fuse3 library and resolve the
# mount server's symbol set, or report why the machine cannot mount. No build-time libfuse anywhere -
# see MODULE.bazel for why that is the design, not an omission.
cc_library(
    name = "fuse_loader_cc",
    srcs = ["fuse_loader.cc"],
    hdrs = ["fuse_loader.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

# The typed fuse3 call surface: the loader's void* symbols cast ONCE into the real function types
# from the fetched headers. The server calls through this; nothing else casts.
cc_library(
    name = "fuse_api_cc",
    srcs = ["fuse_api.cc"],
    hdrs = [
        "fuse_abi.h",
        "fuse_api.h",
    ],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        ":fuse_loader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "fuse_api_test",
    size = "small",
    srcs = ["fuse_api_test.cc"],
    deps = [
        ":fuse_api_cc",
        ":fuse_loader_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_library(
    name = "mount_root_cc",
    srcs = ["mount_root.cc"],
    hdrs = ["mount_root.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

cc_test(
    name = "mount_root_test",
    size = "small",
    srcs = ["mount_root_test.cc"],
    deps = [
        ":mount_root_cc",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

cc_test(
    name = "fuse_loader_test",
    size = "small",
    srcs = ["fuse_loader_test.cc"],
    deps = [
        ":fuse_loader_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "fuse_metadata_cc",
    srcs = ["fuse_metadata.cc"],
    hdrs = ["fuse_metadata.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/time",
        "@xff_extras_api//:vfs_cc",
    ],
)

cc_test(
    name = "fuse_metadata_test",
    size = "small",
    srcs = ["fuse_metadata_test.cc"],
    deps = [
        ":fuse_metadata_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@xff_extras_api//:vfs_cc",
    ],
)

# The read-only FUSE server (epic #183, slice 3b): serves one vfs::FileSystem at one mount point
# through the runtime-loaded fuse3 (fuse_api_cc); no build-time libfuse linkage.
cc_library(
    name = "fuse_server_cc",
    srcs = ["fuse_server.cc"],
    hdrs = ["fuse_server.h"],
    include_prefix = "xff/fuse",
    visibility = ["//visibility:public"],
    deps = [
        ":fuse_api_cc",
        ":fuse_metadata_cc",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

cc_test(
    name = "fuse_server_test",
    size = "medium",
    srcs = ["fuse_server_test.cc"],
    defines = select({
        "@xff_extras_api//:fuse_tests_required": ["XFF_FUSE_TESTS_REQUIRED"],
        "//conditions:default": [],
    }),
    # The kernel-path test needs /dev/fuse and the setuid fusermount3, neither of which works inside
    # bazel's linux sandbox; the test itself only touches its own TempDir. Scoped to the TEST action
    # (not a target-wide "no-sandbox" tag): an unsandboxed COMPILE resolves libc++'s <version> to the
    # stray `version` file at the mbo repo root and breaks the build.
    exec_properties = {"test.no-sandbox": "1"},
    deps = [
        ":fuse_loader_cc",
        ":fuse_server_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

# The extra's identity TU: linking it IS "the fuse extra is compiled in" - it fills the extras-api
# slot and registers the xff FUSE extension notice, and pulls in the server. xff_full links this (and only
# this) under //xff:xff_fuse_on.
cc_library(
    name = "fuse_register_cc",
    srcs = ["fuse_register.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":fuse_server_cc",
        ":mount_root_cc",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:fuse_backend_cc",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:vfs_cc",
    ],
    alwayslink = True,
)

cc_test(
    name = "fuse_register_test",
    size = "small",
    srcs = ["fuse_register_test.cc"],
    deps = [
        ":fuse_register_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:fuse_backend_cc",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)
