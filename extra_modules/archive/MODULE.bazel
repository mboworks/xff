# LICENSES: libarchive itself is BSD-2-Clause. Its resolved codec closure adds Zlib (zlib),
# bzip2-1.0.6, public-domain liblzma, BSD-2-Clause (lz4), and BSD-3-Clause (zstd's permissive arm).
# Mbed TLS is disabled. All selected components are permissive; no copyleft arm is selected.
# Every notice ships through the license-notice registry in @xff_extras_api.
module(
    name = "xff_archive",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_fuzzing", version = "0.8.0")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "libarchive", version = "3.8.1.bcr.3")

# The two codecs a phar can compress its MEMBERS with. libarchive already links both (they are in its
# codec closure), but a phar's per-entry compression is not a libarchive format: the manifest says
# "this member is deflate" and the bytes are a raw stream at an offset, so the reader has to inflate it
# itself. Same versions libarchive resolves, so nothing new enters the build.
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "xff_extras_api", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

# mboworks_mbo resolves via the root module's override (overrides are root-global). Used by the tests
# (mbo/testing status matchers) AND by production code here, for the MBO_ASSIGN_OR_RETURN /
# MBO_RETURN_IF_ERROR status macros that STYLE_CPP.md requires instead of hand-written propagation.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "mboworks_mbo", version = "0.14.0")
