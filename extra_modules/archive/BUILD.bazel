# The libarchive-backed archive reader: the archive build extra (#83), a target of the standalone
# @xff_archive module (this directory's MODULE.bazel). It depends only on @libarchive and the
# shared @xff_extras_api license-notice seam - never on the xff core - so the core keeps no
# knowledge of it and deleting this directory drops the extra entirely.
#
# This slice is the reader alone (headers -> Members). The VFS backend that turns those members
# into virtual entries, and the --archive wiring that mounts it, are later slices; the CLI surface
# already exists and errors self-documentingly until they land.
#
# `alwayslink` keeps the license-notice registration TU from being dropped by the linker.
# The mini container, exported so end-to-end tests in the CORE repo can drive the built binary over
# a REAL archive instead of one they build at runtime (which would test the builder as much as the
# reader). Its own target rather than the whole test_data glob, so a consumer names ONE file and
# `$(rootpath)` resolves.
filegroup(
    name = "mini_tar",
    srcs = ["test_data/mini.tar"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "mini_tar_br",
    srcs = ["test_data/mini.tar.br"],
    visibility = ["//visibility:public"],
)

# The breadth fixture: 1000 members whose content each name predicts. Exported for the same reason
# as mini_tar - an end-to-end test in the CORE repo should drive the built binary over a REAL
# container, and this one is large enough to make a walk spend real time inside it.
filegroup(
    name = "many_tar_gz",
    srcs = ["test_data/many.tar.gz"],
    visibility = ["//visibility:public"],
)

