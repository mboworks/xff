# Round-trips a real tar through the backend: the test WRITES an archive with libarchive (including
# a nested member whose parent directories are NOT stored), then walks it through the seam. That is
# what proves the decisions hold - synthesized parents, read-only + kArchiveMember tagging, a
# refusing Remove, and ReadContent reporting Unimplemented rather than an empty string.
cc_test(
    name = "archive_fs_test",
    size = "medium",
    srcs = ["archive_fs_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_ARCHIVE_FIXTURE_ANCHOR": "$(rootpath test_data/mini.tar)"},
    # The breadth test reads all 1000 members of many.tar.gz. Its ten parameter cases are sharded so
    # the expensive content reads run concurrently, especially under MSan's origin tracking.
    shard_count = 10,
    deps = [
        ":archive_fs_cc",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@libarchive//libarchive",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
)

# PHP's NATIVE phar format, which libarchive does not read at all: a PHP stub ending in
# `__HALT_COMPILER();` followed by a binary manifest and the member data. Same `Member` shape as the
# libarchive reader, so the VFS backend and the walk stay format-agnostic. The tar- and zip-based
# phar variants need nothing here - they are ordinary tars / zips for `:archive_reader_cc`.
cc_library(
    name = "phar_reader_cc",
    srcs = ["phar_reader.cc"],
    hdrs = ["phar_reader.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@bzip2//:bz2",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:license_notice_cc",
        "@xff_extras_api//:member_path_cc",
        "@zlib",
    ],
    alwayslink = True,
)

# There is no phar WRITER to lean on, so the test builds containers byte by byte: the fixture is the
# format specification, and every field offset the reader relies on is pinned by a case that would
# read garbage if it were wrong (a non-empty alias, a second member's data offset, a lying member
# count).
cc_test(
    name = "phar_reader_test",
    size = "small",
    srcs = ["phar_reader_test.cc"],
    deps = [
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@zlib",
    ],
)

# Arbitrary containers exercise the native PHAR recognizer, manifest parser, and bounded member
# reader. Ordinary `bazel test` replays the committed PHP-generated fixtures; continuous campaigns
# use the same target with libFuzzer.
cc_fuzz_test(
    name = "phar_reader_fuzz_test",
    size = "small",
    srcs = ["phar_reader_fuzz_test.cc"],
    corpus = [
        "test_data/entrybz2.phar",
        "test_data/entrygz.phar",
        "test_data/plain.phar",
        "test_data/sha256.phar",
    ],
    dicts = ["phar_reader_fuzz_test.dict"],
    deps = [
        ":phar_reader_cc",
        "@abseil-cpp//absl/status",
    ],
)

# Reads the COMMITTED fixtures, which PHP itself wrote (test_data/README.md explains why they are
# checked in rather than generated during the test: a fixture from our own writer would only prove the
# reader is self-consistent, and the tests must not need a PHP interpreter).
#
# The `env` entry hands the test one fixture's runfiles path so it can derive the directory. That
# indirection is needed because this test lives in an EXTERNAL bazel module: its runfiles sit under
# the module's canonical repo directory, whose name (`xff_archive+`) is a bazel implementation detail
# a test must not hard-code, and $(rootpath) is the supported way to be told it.
cc_test(
    name = "phar_fixture_test",
    size = "small",
    srcs = ["phar_fixture_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_PHAR_FIXTURE_ANCHOR": "$(rootpath test_data/plain.phar)"},
    deps = [
        ":archive_fs_cc",
        ":archive_reader_cc",
        ":phar_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# Coverage for the PACKAGE formats that need no reader of their own - jar / wheel / npm tgz / gem /
# deb / rpm are zip, tar, ar or cpio wrappers, so libarchive already reads them and xff already dives
# into them. That was shipped behaviour with no test. Also records what libarchive does with a payload
# sitting BEHIND a prefix (self-extracting zips, CRX3, JMOD), which decides whether those formats need
# any mechanism of ours at all.
cc_test(
    name = "format_fixture_test",
    size = "small",
    srcs = ["format_fixture_test.cc"],
    data = glob(["test_data/*"]),
    env = {"XFF_ARCHIVE_FIXTURE_ANCHOR": "$(rootpath test_data/example.jar)"},
    deps = [
        ":archive_reader_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
    ],
)

# Registers this extra into the core's archive seam - the only thing that makes `--archive` able to
# look inside a container. `alwayslink` because the registration is a static-init side effect with no
# symbol anyone references, so the linker would otherwise drop the whole TU.
cc_library(
    name = "archive_register_cc",
    srcs = ["archive_register.cc"],
    hdrs = ["archive_register.h"],
    include_prefix = "xff/archive",
    visibility = ["//visibility:public"],
    deps = [
        ":archive_extension_cc",
        ":archive_fs_cc",
        ":archive_pack_cc",
        ":archive_reader_cc",
        ":archive_writer_cc",
        ":phar_writer_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "@mboworks_mbo//mbo/status:status_macros_cc",
        "@xff_extras_api//:archive_backend_cc",
        "@xff_extras_api//:member_path_cc",
        "@xff_extras_api//:vfs_cc",
    ],
    alwayslink = True,
)

# Proves the registration actually happens by ASKING THE SEAM, not the class: a test that called
# ArchiveFileSystem::Open directly would pass even if the registrar were dropped, which is exactly the
# failure this guards (an `alwayslink` that someone removes looks fine until --archive stops working).
cc_test(
    name = "archive_register_test",
    size = "small",
    srcs = ["archive_register_test.cc"],
    data = ["test_data/tarbased.phar.tar"],
    env = {"XFF_ARCHIVE_REGISTER_PHAR": "$(rootpath test_data/tarbased.phar.tar)"},
    deps = [
        ":archive_extension_cc",
        ":archive_fs_cc",
        ":archive_register_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mboworks_mbo//mbo/testing:status_cc",
        "@xff_extras_api//:archive_backend_cc",
    ],
)
